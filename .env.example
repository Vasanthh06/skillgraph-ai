# Copy to .env. Never commit .env.
#
# Normal operation: DEMO_MODE=false. Demo accounts (scripts/seed_demo.py) cannot log in unless this is true.
DEMO_MODE=false
# REQUIRED when DEMO_MODE=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://skillgraph:skillgraph@localhost:5432/skillgraph
# No Postgres handy (local dev / single instance only)? SQLite works:
# DATABASE_URL=sqlite:////absolute/path/to/skillgraph.db
# With the frontend's same-origin /api proxy (the default) CORS is not exercised by the web app;
# list your real frontend origin(s) here if you serve the API on a separate origin (comma-separated).
CORS_ORIGINS=http://localhost:5173
# Frontend only (set where Vite runs, not needed by the backend):
# VITE_API_PROXY=http://localhost:8000   # backend address for the dev/preview /api proxy (use http://backend:8000 in Docker Compose)
# VITE_API_URL=https://api.example.com  # ONLY for a separate API origin; unset = same-origin "/api"
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
# Optional: leave empty to use generated YouTube search URLs
YOUTUBE_API_KEY=

# Same-origin web session; HTTPS + COOKIE_SECURE=true in production
APP_URL=http://localhost:5173
COOKIE_SECURE=false
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_ENABLED=false
